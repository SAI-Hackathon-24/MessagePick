{
  "compilerOptions": {
    /* 语言与模块：ES2023 + Node 26 / tsx / vite 均可用的组合（moduleResolution: bundler）。
       相对导入不必写扩展名；@shared/* 等别名与 vite.config.ts 的 resolve.alias 保持一致。 */
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],

    /* 严格性 */
    "strict": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,

    /* 类型检查模式：产物由 vite（前端）与 tsx（服务端）负责，tsc 只做 --noEmit 检查 */
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "paths": {
      "@shared": ["./src/shared/index.ts"],
      "@shared/*": ["./src/shared/*"],
      "@server/*": ["./src/server/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vitest.config.ts"],
  "exclude": ["node_modules", "dist"]
}

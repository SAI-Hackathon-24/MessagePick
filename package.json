{
  "name": "messagepick",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MessagePick —— 单机单用户的本地微信群聊天记录分析应用（梗分析 / 信息提取 / 社交画像 / 再创作生成）",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm --prefix webui run build && tsc --noEmit",
    "dev:server": "tsx watch src/server/main.ts",
    "dev:web": "vite",
    "start": "tsx src/server/main.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "echarts": "6.1.0",
    "echarts-wordcloud": "2.1.0",
    "express": "5.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/express": "5.0.6",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "overrides": {
    "echarts-wordcloud": {
      "echarts": "$echarts"
    }
  }
}
